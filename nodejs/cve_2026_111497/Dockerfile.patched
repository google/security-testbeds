# Patched Node.js 22.23.4 image bundling the Brotli decoder fix for
# CVE-2026-111497 (used to verify zero false positives).
FROM node:22.23.4-slim
LABEL name="nodejs_cve_2026_111497_patched"

WORKDIR /usr/src/app

COPY package.json ./
RUN npm install --omit=dev

COPY server.js ./

EXPOSE 3000
CMD ["node", "server.js"]
